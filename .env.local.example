# Supabase Environment Variables
# Copy this file to .env.local and fill in your values from:
# https://app.supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — bypasses RLS. Used server-side only for admin operations.
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin dashboard credentials
ADMIN_USERNAME=kristy
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
ADMIN_SESSION_SECRET=your_random_secret_here

# Groq API Key — used by the AI chatbot (/api/chat)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
